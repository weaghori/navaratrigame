# Client-safe Shopify app key. It is public by design and is returned to the
# authenticated embedded-app loader for App Bridge.
SHOPIFY_API_KEY=

# Server-only: configure these in the Vercel server environment, never in a
# client-prefixed variable (VITE_, NEXT_PUBLIC_, or PUBLIC_).
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,read_orders,write_metaobjects,write_metaobject_definitions,write_discounts,read_discounts,write_price_rules,read_price_rules,write_app_proxy
SHOP_CUSTOM_DOMAIN=

# Active server-side database. Use an Atlas URI with the intended DB name.
MONGODB_DATABASE_URL=

# Active server-side media storage. These values must never reach the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional server-only compatibility for legacy Supabase-hosted audio URLs.
# Omit after all runtime data has been confirmed to reference R2 or other URLs.
SUPABASE_URL=
